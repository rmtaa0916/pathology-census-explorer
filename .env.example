# Set as HTTPS PHP-hosting environment variables; do not commit real credentials.
APP_MODE=demo
APP_ACCESS_USER=
# Generate with: php -r 'echo password_hash("YOUR-STRONG-PASSWORD", PASSWORD_DEFAULT), PHP_EOL;'
APP_ACCESS_PASSWORD_HASH=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/path/outside/public/root/service-account.json
# Kept off for read-only pilot; only DEMO - Weekly Census count cells can ever be edited.
APP_WRITE_ENABLED=0
